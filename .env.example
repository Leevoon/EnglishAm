# Copy to .env and fill in real values. NEVER commit .env.
# Reading order in EnglishAm/settings.py is django-environ → os.environ.

# === Django ===
# Generate via: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=replace-me-with-a-real-key

# 1 in dev, 0 in production. NEVER 1 in production.
DJANGO_DEBUG=0

# Comma-separated. Must include every hostname/IP the site is reached at.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Schemes required for CSRF in production (Django ≥ 4 enforces this).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Only needed when the React frontend lives on a different origin than this
# backend (e.g. SPA on https://admin.example.com, API on https://api.example.com).
# Leave empty for same-origin deployments (the default nginx-proxy compose setup).
DJANGO_CORS_ALLOWED_ORIGINS=

# 1 = trust the X-Forwarded-Proto header from your reverse proxy (set for production behind nginx/caddy).
DJANGO_SECURE_PROXY_SSL_HEADER=0

# === Database ===
DB_NAME=english
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=3306

# === Frontend build (passed through docker-compose to Vite) ===
# Empty = same origin (nginx in the frontend image proxies /api to backend).
# Set to e.g. https://api.example.com if the SPA must reach a different host.
VITE_API_BASE_URL=
# Media CDN. Default keeps the legacy public host.
VITE_MEDIA_BASE_URL=https://english.am/vendor/img

# === Error tracking ===
# Leave blank to disable Sentry.
SENTRY_DSN=

# === Bootstrap superuser (used only by `make bootstrap-admin`) ===
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-immediately
