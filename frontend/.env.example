# Copy to frontend/.env to override Vite build-time values.
# Vite only exposes vars prefixed with VITE_ to client code.
# These are baked in at build time — to change them after deploy you must rebuild.

# Backend API host. Empty = same-origin (uses Vite proxy in dev, nginx in prod).
# Set to an absolute URL when frontend and backend live on different origins,
# e.g. https://api.example.com — see CORS note in repo root README.
VITE_API_BASE_URL=

# Where legacy media files live. Default points at the public CDN.
VITE_MEDIA_BASE_URL=https://english.am/vendor/img
